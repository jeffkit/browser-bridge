{
  "name": "browser-bridge-gateway",
  "version": "0.1.0",
  "description": "browser-bridge gateway: WebSocket server for the extension + MCP server (streamable HTTP / stdio) for agents",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "browser-bridge-gateway": "./dist/cli.js"
  },
  "files": ["dist"],
  "scripts": {
