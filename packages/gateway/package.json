{
  "name": "browser-bridge-gateway",
  "version": "0.2.0",
  "description": "browser-bridge gateway: WebSocket server for the extension + MCP server (streamable HTTP / stdio) for agents",
  "type": "module",
  "bin": {
    "browser-bridge-gateway": "./dist/cli.js"
  },
  "files": ["dist"],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jeffkit/browser-bridge.git",
    "directory": "packages/gateway"
  },
  "keywords": [
    "browser",
    "chrome-extension",
    "agent",
    "mcp",
    "model-context-protocol",
    "browser-automation"
  ],
  "license": "MIT",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm run build && vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "commander": "^12.1.0",
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@browser-bridge/protocol": "workspace:*",
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.13",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20"
  }
}
