{
  "manifest_version": 3,
  "name": "browser-bridge",
  "version": "0.2.1",
  "description": "browser-bridge 扩展：把本地浏览器暴露给你的远程 Agent（经 gateway MCP）",
  "minimum_chrome_version": "116",
  "permissions": ["tabs", "scripting", "storage"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "browser-bridge"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
