{
  "manifest_version": 3,
  "name": "browser-bridge",
  "version": "0.3.0",
  "description": "browser-bridge 扩展：把本地浏览器暴露给你的远程 Agent（经 gateway MCP）",
  "browser_specific_settings": {
    "gecko": {
      "id": "browser-bridge@jeffkit.dev",
      "strict_min_version": "128.0"
    }
  },
  "permissions": ["tabs", "scripting", "storage"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "scripts": ["service-worker.js"]
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "browser-bridge"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
